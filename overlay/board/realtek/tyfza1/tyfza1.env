ipaddr=192.168.0.1
httpd_dhcp=1
netmask=255.255.255.0
serverip=192.168.0.2
loadaddr=0x10000000
kernel_addr_r=0x00080000
fdt_addr_r=0x01800000
initrd_addr_r=0x02000000
unzip_src=0x05000000
bootcmd=bootmenu 3
bootmenu_0=Start OpenWrt=run boot_production
bootmenu_1=Web recovery=tyfrecovery
boot_production=tyfboot
